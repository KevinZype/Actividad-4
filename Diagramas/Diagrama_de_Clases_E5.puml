@startuml Ejercicio 5 

skinparam classAttributeIconSize 0
skinparam shadowing false

class "ModuloEjercicio5 <<module>>" as Mod5 {
    + FONDO : str
    + TARJETA : str
    + BORDE : str
    + TEXTO : str
    + GRIS : str
    + ACENTO : str
    + ACENTO_HOVER : str
    + ERROR : str
    + main(ruta: str) : void
}

class App {
    + ventana : tk.Tk
    + tarea : str
    + lineas : list<tuple>
    + ejecutando : bool
    + resumen : str
    + pausa : int
    + carpeta : str
    + letra : str
    + mono : str
    + salida : tk.Text
    + campo_archivo : tk.Entry
    + estado : tk.Label
    + __init__(ventana: tk.Tk)
    + buscar_fuente(opciones: list, por_defecto: str) : str
    + crear_encabezado() : void
    + crear_cuerpo() : void
    + crear_datos(padre) : void
    + crear_campo(padre, texto, fila, valor) : tk.Entry
    + crear_pie() : void
    + crear_boton(padre, texto, comando, fondo, color, hover, borde) : tk.Label
    + examinar() : void
    + ejecutar() : void
    + mostrar_linea() : void
    + limpiar() : void
}

App ..> Mod5 : llama main()

@enduml